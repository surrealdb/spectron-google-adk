# AgentMemory connection. The SDK never reads these itself; the examples in this
# repo load them and pass the values to the client explicitly.
AGENT_MEMORY_ENDPOINT=https://api.agent_memory.example
AGENT_MEMORY_API_KEY=sk-spec-your-key-here
AGENT_MEMORY_CONTEXT=acme-prod

# Google ADK model provider. Required for the example agents to talk to Gemini.
GOOGLE_API_KEY=your-google-api-key-here
